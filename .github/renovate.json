{
  "extends": ["github>open-turo/renovate-config#v1.21.3"],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["(^|/)action\\.ya?ml$"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+?) depName=(?<depName>.+?)\\s+python: (?<currentValue>\\S+)"
      ]
    }
  ]
}
